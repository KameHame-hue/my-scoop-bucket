{
    "version": "10_2a",
    "description": "Stickies，桌面便签小工具（含中文语言包）",
    "homepage": "https://www.zhornsoftware.co.uk/stickies/index.html",
    "license": "Freeware",
    "notes": "语言包 cn.zip 的版本号与软件本体不是同一体系，autoupdate 无法自动判断语言包是否有新版本，需要定期人工核对 https://www.zhornsoftware.co.uk/stickies/download.html 。",
    "url": [
        "https://www.zhornsoftware.co.uk/stickies/stickies_setup_10_2a.zip",
        "https://www.zhornsoftware.co.uk/stickies/xl/cn.zip"
    ],
    "hash": [
        "ba030891b8627078444e37d9dc8e0ceeb63fd18b69866ace2c8d88ff7deb5634",
        "4220e2f83fecfc071b21429eb660e6d6f2ed616661dd6eaa9d02b5ece9297c5d"
    ],
    "bin": "stickies.exe",
    "shortcuts": [
        [
            "stickies.exe",
            "Stickies"
        ]
    ],
    "persist": [
        "stickies.db",
        "backups",
        "rtf"
    ],
    "post_install": [
        "$oldData = \"$env:APPDATA\\stickies\"",
        "$newDb = \"$persist_dir\\stickies.db\"",
        "if ((Test-Path \"$oldData\\stickies.db\") -and ((Get-Item $newDb -ErrorAction SilentlyContinue).Length -eq 0)) { Copy-Item \"$oldData\\stickies.db\" $newDb -Force; Write-Host '已将现有 Stickies 笔记数据迁移到持久化目录' -ForegroundColor Green }",
        "if ((Test-Path \"$oldData\\backups\") -and ((Get-ChildItem \"$persist_dir\\backups\" -ErrorAction SilentlyContinue | Measure-Object).Count -eq 0)) { Copy-Item \"$oldData\\backups\\*\" \"$persist_dir\\backups\" -Recurse -Force }",
        "if ((Test-Path \"$oldData\\rtf\") -and ((Get-ChildItem \"$persist_dir\\rtf\" -ErrorAction SilentlyContinue | Measure-Object).Count -eq 0)) { Copy-Item \"$oldData\\rtf\\*\" \"$persist_dir\\rtf\" -Recurse -Force }"
    ],
    "checkver": {
        "url": "https://www.zhornsoftware.co.uk/stickies/download.html",
        "regex": "stickies_setup_([\\d_a-z]+)\\.zip"
    },
    "autoupdate": {
        "url": [
            "https://www.zhornsoftware.co.uk/stickies/stickies_setup_$version.zip",
            "https://www.zhornsoftware.co.uk/stickies/xl/cn.zip"
        ]
    }
}