{
    "version": "2.12.6",
    "description": "LX Music 桌面版，免费开源音乐播放器",
    "homepage": "https://github.com/lyswhut/lx-music-desktop",
    "license": "Apache-2.0",
    "notes": "程序主文件名（bin）按常见 Electron 应用命名猜测为 lx-music-desktop.exe，首次安装后请核对压缩包内实际文件名，如不一致请告知以便修正。",
    "url": "https://github.com/lyswhut/lx-music-desktop/releases/download/v2.12.6/lx-music-desktop-v2.12.6-win_x64-green.7z",
    "hash": "a07d2a15dbcf06ce689bf8b99c64241b06deb28fdfb6ffe79b6dcdfbb0d157a5",
    "bin": "lx-music-desktop.exe",
    "shortcuts": [
        [
            "lx-music-desktop.exe",
            "LX Music"
        ]
    ],
    "persist": "portable",
    "post_install": [
        "$oldData = \"$env:APPDATA\\lx-music-desktop\"",
        "$newData = \"$persist_dir\\portable\"",
        "if (!(Test-Path $newData)) { New-Item -ItemType Directory -Path $newData -Force | Out-Null }",
        "if ((Test-Path $oldData) -and ((Get-ChildItem $newData -ErrorAction SilentlyContinue | Measure-Object).Count -eq 0)) { Copy-Item \"$oldData\\*\" $newData -Recurse -Force; Write-Host '已将现有 LX Music 数据迁移到持久化目录' -ForegroundColor Green }"
    ],
    "checkver": {
        "github": "https://github.com/lyswhut/lx-music-desktop"
    },
    "autoupdate": {
        "url": "https://github.com/lyswhut/lx-music-desktop/releases/download/v$version/lx-music-desktop-v$version-win_x64-green.7z"
    }
}